# Copie ce fichier en ".env" et adapte les valeurs.

# Port d'accès depuis le réseau local : http://IP-DU-NAS:PORT
PORT=8080

# Nom du conteneur
CONTAINER_NAME=montage-photo

# Fuseau horaire
TZ=Europe/Paris

# Dossier contenant index.html, script.js et styles.css (chemin sur le NAS ou relatif)
APP_DIR=./app
